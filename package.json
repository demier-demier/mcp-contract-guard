{
  "name": "mcp-contract-guard",
  "version": "0.1.0",
  "description": "Offline review gate for changes in exported MCP tool contracts",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22" },
  "bin": { "mcp-contract-guard": "dist/cli.js" },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist/", "README.md", "PROVENANCE.md", "docs/THREAT-MODEL.md", "docs/FORMAT.md", "fixtures/"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "demo:check": "npm run build && node scripts/demo.mjs --check",
    "prepack": "npm run build"
  },
  "devDependencies": { "@types/node": "22.20.5", "typescript": "5.9.3" }
}
